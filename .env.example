DATABASE_URL=postgresql://demo:demo@127.0.0.1:54329/ticket_studio
# Leave these empty until you have Vertex AI access. No mock AI is used in the app.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
GEMINI_MODEL=
# local or cloud-tasks
TASK_BACKEND=local
STORAGE_BACKEND=local
UPLOAD_DIR=.data/uploads
# Cloud deployment only
GCS_BUCKET=
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=ticket-reviews
CLOUD_TASKS_SERVICE_ACCOUNT=
# Exact service origin, e.g. https://ticket-studio-xxx.europe-west1.run.app
APP_URL=http://localhost:3000
